{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepeaterSpec",
  "type": "object",
  "required": ["name", "rx_frequency_mhz", "tx_frequency_mhz", "mode", "source_id"],
  "properties": {
    "name": {"type": "string"},
    "callsign": {"type": ["string", "null"]},
    "nearest_city": {"type": ["string", "null"]},
    "rx_frequency_mhz": {"type": ["string", "number"]},
    "tx_frequency_mhz": {"type": ["string", "number"]},
    "mode": {"enum": ["FM", "DMR", "DSTAR", "FUSION", "P25", "NXDN", "TETRA", "M17"]},
    "ctcss_tx_hz": {"type": ["string", "number", "null"]},
    "ctcss_rx_hz": {"type": ["string", "number", "null"]},
    "dcs_tx_code": {"type": ["string", "null"]},
    "dcs_rx_code": {"type": ["string", "null"]},
    "dcs_code": {"type": ["string", "null"], "description": "legacy; read as dcs_tx_code"},
    "latitude": {"type": ["string", "number", "null"]},
    "longitude": {"type": ["string", "number", "null"]},
    "distance_km": {"type": ["string", "number", "null"]},
    "operational_status": {"type": ["string", "null"]},
    "use": {"type": ["string", "null"]},
    "band": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "allstar_node": {"type": ["string", "null"]},
    "echolink_node": {"type": ["string", "null"]},
    "irlp_node": {"type": ["string", "null"]},
    "wires_node": {"type": ["string", "null"]},
    "last_update": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "source_id": {"type": "string"},
    "params": {"type": ["object", "null"]}
  }
}
